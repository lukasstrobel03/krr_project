:Severe rdf:type owl:NamedIndividual ,
                 :SeverityLevel .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AnxietySymptom
                :CognitiveSymptom
                :DepressionSymptom
                :MoodSymptom
                :PsychomotorSymptom
                :RiskSymptom
